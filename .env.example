# Core Application Settings
APP_NAME="Smart Agriculture Platform"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///./smart_ag.db

# Disease Detection Model & Inference Provenance
MODEL_CHECKPOINT_PATH=models/best_model.pth
MODEL_VERSION=1.1.0
MODEL_ARCHITECTURE=resnet50
IMAGE_SIZE=224
MAX_UPLOAD_BYTES=10485760
DEFAULT_DEVICE=cuda
